{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classicmac.dev/schema/source-record-v1.json",
  "title": "ClassicMac Source Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "title", "locator", "redistribution", "trust"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]+$"},
    "kind": {
      "enum": [
        "git_commit",
        "repository_file",
        "primary_documentation",
        "vendor_header",
        "vendor_release_note",
        "vendor_sample_code",
        "historical_book",
        "installed_toolchain",
        "hardware_experiment",
        "community_report",
        "third_party_prior_art",
        "external_research"
      ]
    },
    "title": {"type": "string"},
    "locator": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "repository": {"type": "string"},
        "sha": {"type": "string"},
        "path": {"type": "string"},
        "url": {"type": "string"},
        "local_source_id": {"type": "string"}
      }
    },
    "redistribution": {"enum": ["public", "metadata_only", "private", "unknown"]},
    "trust": {"enum": ["first_party_verified", "primary_source", "controlled_observation", "secondary", "unverified"]},
    "vendor": {"type": "string"},
    "revision": {"type": "string"},
    "retrieval": {
      "enum": [
        "automatic",
        "followup",
        "explicit_or_followup",
        "explicit_only",
        "explicit_only_for_cplusplus"
      ]
    },
    "applicability": {"type": "object", "additionalProperties": true},
    "domains": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"type": "string"},
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "order": {"type": "integer", "minimum": 1},
              "path": {"type": "string"}
            }
          }
        ]
      }
    },
    "restrictions": {"type": "object", "additionalProperties": true},
    "notes": {"type": "string"},
    "collected_at": {"type": "string", "format": "date-time"}
  }
}
